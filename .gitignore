# 抖店导出数据（每天两次自动生成，不纳入版本管理）
# 这些文件由 doudian_export.py 自动产出并按 --keep 2 滚动清理，
# 每天新增 2 份、删除 2 份。若纳入版本管理，
# Git 会为每次内容变化存一份完整快照，仓库体积会无意义地持续膨胀。
# 需要留档时请手动复制到别处，或改用带日期的归档目录。
商品数据/*.xlsx

# 保留目录结构，方便 clone 后直接查看
!商品数据/.gitkeep

# Python
__pycache__/
*.py[cod]

# 系统与编辑器
Thumbs.db
desktop.ini
.DS_Store
*.swp
.vscode/

# 视频处理工具（video-cleaner）：代码、模板、说明纳入版本管理；
# 下列运行时依赖体积达 5GB，换机时按 README 重新部署即可，不纳入。
video-cleaner/.venv/
video-cleaner/tools/
video-cleaner/input/
video-cleaner/output/
video-cleaner/frames/
video-cleaner/models/*.pt
video-cleaner/models/*.onnx
video-cleaner/models/big-lama/
video-cleaner/**/__pycache__/

# 下载的带货短视频（每个商品一个文件夹，体积大且随时清空重下）
带货短视频/

# 榜单抓取缓存（含带签名的临时直链，几小时即过期，每次运行重新抓取）
商品数据/*.json
